{
  "name": "selfdesk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:mcp": "cd mcp && npm ci && npm run build",
    "test": "tsx tests/core.test.ts && tsx tests/mcp.test.ts",
    "check:rules": "node scripts/check.mjs",
    "check:scope": "node scripts/check-scope.mjs",
    "kit": "node scripts/build-kit.mjs",
    "check": "npm run check:rules && tsc --noEmit && (cd mcp && npx tsc --noEmit) && npm test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vite": "^8.3.8"
  }
}
